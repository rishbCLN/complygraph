# ComplyGraph environment configuration
# Copy to .env for local development. NEVER commit .env.

# --- Database ---
POSTGRES_DB=complygraph
POSTGRES_USER=complygraph
POSTGRES_PASSWORD=complygraph_dev_pw
DATABASE_URL=postgresql+psycopg://complygraph:complygraph_dev_pw@postgres:5432/complygraph

# Demo source database (synthetic AsterLane customer platform)
DEMO_DATABASE_URL=postgresql+psycopg://complygraph:complygraph_dev_pw@postgres:5432/asterlane

# --- Redis / Worker ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Security ---
# Generate real values for anything beyond local dev.
SECRET_KEY=dev-secret-key-change-me-in-production-please-0123456789
# 32-byte urlsafe base64 key for connector credential encryption (Fernet).
APP_ENCRYPTION_KEY=dev-encryption-key-change-me-0123456789abcdefABCDEF=

# --- AI ---
# If ANTHROPIC_API_KEY is empty, AI_MODE falls back to deterministic automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# One of: anthropic | deterministic
AI_MODE=deterministic
AI_MAX_CALLS_PER_SESSION=20

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- App ---
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
